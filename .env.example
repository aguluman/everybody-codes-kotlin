# Value of the "everybody-codes" cookie (devtools -> Application -> Cookies).
# It's a JWT that expires about a week after login; `make fetch` warns when it's close.
EC_TOKEN=

# Your account seed: the number in your input file's name (79.json -> 79).
EC_SEED=

# Cookie name. Leave blank to use "everybody-codes"; set it only if the site renames it.
EC_COOKIE=

# How requests identify this tool to the site. Leave blank for the default,
# or add your own contact as a courtesy.
EC_USER_AGENT="everybody-codes-kotlin (github.com/your-handle)"
